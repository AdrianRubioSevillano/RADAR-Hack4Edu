{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "vite/client",
      "node"
    ]
  },
  "include": [
    "src/*.tsx",
    "src/*.ts",
    "src/services",
    "src/components",
    "src/screens",
    "src/core",
    "src/content",
    "tests/app",
    "tests/core",
    "tests/content",
    "vite.config.ts",
    "scripts"
  ]
}
